---
import "@/styles/globals.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Rosesblumen | Fresh Cut Flowers and Bouquetsin Nanyuki",
	description = "Rosesblumen offers fresh-cut flowers and bouquetsin Nanyuki, Kenya.",
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/img/rosesblumen-stand-001.jpg", canonicalUrl).href;
const businessData = {
	"@context": "https://schema.org",
	"@type": "Florist",
	name: "Rosesblumen",
	url: canonicalUrl.href,
	image: shareImage,
	logo: new URL("/img/roses-blumen-logo.svg", canonicalUrl).href,
	telephone: "+254112822876",
	address: {
		"@type": "PostalAddress",
		streetAddress: "Rosesblumen",
		addressLocality: "Nanyuki",
		addressCountry: "KE",
	},
	areaServed: "Nanyuki, Kenya",
	sameAs: ["https://www.instagram.com/rosesblumen/", "https://m.facebook.com/rosesblumen"],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content="Thomas Schwinn" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="canonical" href={canonicalUrl.href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rosesblumen" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content="en_KE" />
		<meta property="og:image" content={shareImage} />
		<meta property="og:image:secure_url" content={shareImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1600" />
		<meta property="og:image:height" content="998" />
		<meta property="og:image:alt" content="Fresh flowers at the Rosesblumen flower stand" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
		<meta name="twitter:image:alt" content="Fresh flowers at the Rosesblumen flower stand" />
		<link rel="icon" type="image/png" href="/rosesblumen_favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(businessData)} />
	</head>
	<body>
		<slot />
		<div class="fixed bottom-5 right-5 z-40 flex flex-col gap-3 sm:bottom-6 sm:right-6">
			<a
				href="#kontakt"
				data-contact-jump
				aria-label="Go to the contact form"
				title="Email"
				class="grid size-14 place-items-center rounded-full bg-primary text-primary-foreground shadow-lg transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
			>
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="5" width="18" height="14" rx="2" />
					<path d="m3 7 9 6 9-6" />
				</svg>
			</a>
			<a
				href="https://wa.me/254112822876"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Chat with Rosesblumen on WhatsApp"
				title="WhatsApp"
				class="grid size-14 place-items-center rounded-full bg-[#25d366] shadow-lg transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25d366] focus-visible:ring-offset-2"
			>
				<img src="/img/whatsapp.svg" alt="" width="28" height="28" class="brightness-0 invert" />
			</a>
		</div>
	</body>
</html>
