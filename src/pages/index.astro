---
import SiteLayout from "@/layouts/SiteLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { Button } from "@/components/ui/button.jsx";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card.jsx";
import { Input } from "@/components/ui/input.jsx";
import { Label } from "@/components/ui/label.jsx";
import { Textarea } from "@/components/ui/textarea.jsx";
import InstagramFeed from "@/components/InstagramFeed.jsx";
import instagramData from "@/data/instagram-initial.json";
---

<SiteLayout>
	<main class="mx-auto w-full max-w-screen-xl px-6 pt-8 sm:px-10 lg:px-12">
		<section class="pb-16 pt-2 text-center sm:pb-20">
			<img
				src="/img/roses-blumen-logo.svg"
				alt="Rosesblumen"
				width="280"
				height="88"
				fetchpriority="high"
				class="mx-auto mb-16 h-auto w-[min(82vw,680px)]"
			/>
			<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Fresh flowers</h1>
			<p class="mt-3 text-lg sm:text-xl">From 2021 to 2025 every saturday from 8 am–2 pm at Karmelitermarkt, Vienna/Austria</p>
		<p class="mt-3 text-lg sm:text-xl">we are now in Nanyuki</p></section>

		<img
			src="/img/rosesblumen-stand-001.jpg"
			alt="Rose at her flower stand with fresh-cut flowers at Karmelitermarkt"
			width="1600"
			height="998"
			fetchpriority="high"
			class="mx-auto h-auto w-full object-cover"
		/>

		<InstagramFeed
			profile={instagramData.profile}
			posts={instagramData.posts}
			pageSize={instagramData.pageSize}
			pageCount={instagramData.pageCount}
			totalPosts={instagramData.totalPosts}
			client:load
		/>

		<section id="kontakt" class="mx-auto max-w-3xl scroll-mt-8 px-0 py-20 sm:px-6 lg:py-24">
			<Card class="overflow-hidden">
				<CardHeader class="gap-2 pb-4 sm:p-8 sm:pb-5">
					<p class="text-sm font-semibold uppercase tracking-[0.14em] text-brand">Contact</p>
					<CardTitle class="text-3xl sm:text-4xl">How can I help you?</CardTitle>
					<CardDescription class="prose prose-neutral max-w-xl text-base leading-7">
						<p>Send me a message. I will get back to you as soon as possible.</p>
					</CardDescription>
				</CardHeader>
				<CardContent class="sm:p-8 sm:pt-0">
					<div id="contact-success" class="hidden rounded-xl bg-emerald-50 px-6 py-10 text-center ring-1 ring-emerald-200" role="status" aria-live="polite">
						<div class="mx-auto grid size-16 place-items-center rounded-full bg-emerald-100 text-emerald-700">
							<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m5 12 4 4L19 6" />
							</svg>
						</div>
						<h3 class="mt-5 text-2xl font-semibold text-emerald-950">Thank you!</h3>
						<p class="mx-auto mt-2 max-w-md leading-7 text-emerald-900">Thank you for reaching out. We’ll get back to you as soon as we can.</p>
					</div>
					<p id="contact-error" class="hidden rounded-md bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-red-200" role="alert" aria-live="assertive">
						Your message could not be sent. Please try again or call me at <a class="font-medium underline underline-offset-4" href="tel:+254112822876">+254 112 822 876</a>.
					</p>
					<form id="contact-form" action="/api/contact" method="post" class="grid gap-5">
						<div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
							<label for="company">Please leave this field empty</label>
							<input id="company" name="company" tabindex="-1" autocomplete="off" />
						</div>
						<div class="grid gap-5 sm:grid-cols-2">
							<div class="grid gap-2">
								<Label htmlFor="name">Full name</Label>
								<Input id="name" name="name" autoComplete="name" placeholder="Your name" required maxLength="80" />
							</div>
							<div class="grid gap-2">
								<Label htmlFor="email">Email address</Label>
								<Input id="email" name="email" type="email" autoComplete="email" placeholder="you@example.com" required maxLength="254" />
							</div>
						</div>
						<div class="grid gap-2">
							<Label htmlFor="message">Your message</Label>
							<Textarea id="message" name="message" placeholder="How can I help?" required minLength="5" maxLength="5000"></Textarea>
						</div>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
							<Button type="submit" class="w-full sm:w-auto">Send message</Button>
							<p class="text-sm text-muted-foreground">Or call me: <a class="font-medium text-foreground underline underline-offset-4" href="tel:+254112822876">+254 112 822 876</a></p>
						</div>
					</form>
				</CardContent>
			</Card>
		</section>
	</main>

	<SiteFooter />
</SiteLayout>

<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const success = document.querySelector<HTMLElement>("#contact-success");
	const error = document.querySelector<HTMLElement>("#contact-error");
	const result = new URLSearchParams(window.location.search).get("contact");
	if (result === "success") {
		form?.classList.add("hidden");
		success?.classList.remove("hidden");
	} else if (result === "error") {
		error?.classList.remove("hidden");
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (submitButton) {
			submitButton.disabled = true;
			submitButton.textContent = "Sending…";
		}
		error?.classList.add("hidden");

		try {
			const response = await fetch(form.action, {
				method: form.method,
				body: new FormData(form),
				redirect: "follow",
			});
			const status = new URL(response.url).searchParams.get("contact");
			if (!response.ok || status !== "success") throw new Error("Contact submission failed");
			form.classList.add("hidden");
			success?.classList.remove("hidden");
		} catch {
			error?.classList.remove("hidden");
		} finally {
			if (submitButton && !form.classList.contains("hidden")) {
				submitButton.disabled = false;
				submitButton.textContent = "Send message";
			}
		}
	});
</script>
